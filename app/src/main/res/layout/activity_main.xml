<!--                        android:textStyle="bold"-->
<!--                        android:visibility="visible" />-->

                </FrameLayout>



                <LinearLayout
                    android:id="@+id/numberLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:elevation="1dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_corner_white"
                        android:backgroundTint="#ff051367"
                        android:gravity="center"
                        android:onClick="whatsAppNumber"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <!-- WhatsApp Icon -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center"
                            android:padding="2dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_whatsappicon" />

                        <!-- Chat Now Text -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/whatsAppNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:singleLine="true"
                            android:text="Chat Now"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/rounded_corner_white"
                        android:backgroundTint="#ff051367"
                        android:gravity="center"
                        android:onClick="callNumber"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/call" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/callNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="Call Now"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="9dp">


                    <LinearLayout
                        android:id="@+id/openBottomSheet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_button_gradient">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/withdraw"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="10dp"
                                android:layout_marginLeft="35dp"
                                android:layout_weight="1"
                                android:paddingVertical="5dp"
                                android:text="Star and Gali Games"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                app:textAllCaps="true" />

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:layout_gravity="center"
                                android:layout_marginEnd="8dp"
                                android:padding="2dp"
                                android:scaleType="fitXY"
                                android:src="@drawable/next" />
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/stripLayout"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/ll_whole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:elevation="1dp"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            tools:listitem="@layout/recycler_view_layout" />

                        <ImageView
                            android:id="@+id/nogame_iv"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_win_history_icon_2_01"
                            android:visibility="gone" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_centerInParent="true"

            android:indeterminateTint="@color/white"
            android:visibility="gone" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/naviagationMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/background_bg"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include
            android:id="@+id/drawerHeader"
            layout="@layout/drawer_header" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/navigation_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/drawer_menu_item" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>