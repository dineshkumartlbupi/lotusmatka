<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".GameActivity.GameActivity">

    <include
        android:id="@+id/appbarLayout"
        layout="@layout/custom_appbar08" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/dataConText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/appbarLayout"
        android:background="@color/warningRed"
        android:elevation="1dp"
        android:padding="5dp"
        android:text="@string/you_are_not_connected_to_internet"
        android:textColor="@color/white"
        android:visibility="gone" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/dataConText">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
           >

                <!-- First Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/firstCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardUseCompatPadding="true"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/secondCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45"
                    android:paddingBottom="20dp"> <!-- Added margin to create space around the card -->

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/starIcon"
                            android:layout_width="@dimen/_108sdp"
                            android:layout_height="@dimen/_108sdp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginVertical="@dimen/_14sdp"
                            android:contentDescription="Star Animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/animation"
                            tools:ignore="DuplicateIds" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/singleDigit"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:onClick="singleDigit"
                            android:src="@drawable/sd" />

                        <ImageView
                            android:id="@+id/arrowIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:contentDescription="Arrow Icon"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="DuplicateIds" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Second Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/secondCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardUseCompatPadding="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/firstCard"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45"> <!-- Added margin to create space around the card -->

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/starIcon"
                            android:layout_width="@dimen/_108sdp"
                            android:layout_height="@dimen/_108sdp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginVertical="@dimen/_14sdp"
                            android:contentDescription="Star Animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/animation"
                            tools:ignore="DuplicateIds" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/jodiDigit"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="25dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:onClick="jodiDigit"
                            android:src="@drawable/jd" />

                        <ImageView
                            android:id="@+id/arrowIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:contentDescription="Arrow Icon"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="DuplicateIds" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!--           second row      -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <!-- First Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/r2firstCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardUseCompatPadding="true"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/r2secondCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/starIcon"
                            android:layout_width="@dimen/_108sdp"
                            android:layout_height="@dimen/_108sdp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginVertical="@dimen/_14sdp"
                            android:contentDescription="Star Animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/animation"
                            tools:ignore="DuplicateIds" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/singlePana"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="25dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:onClick="singlePana"
                            android:src="@drawable/sp" />

                        <ImageView
                            android:id="@+id/arrowIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:contentDescription="Arrow Icon"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="DuplicateIds" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Second Card -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/r2secondCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/r2firstCard"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/starIcon"
                            android:layout_width="@dimen/_108sdp"
                            android:layout_height="@dimen/_108sdp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginVertical="@dimen/_14sdp"
                            android:contentDescription="Star Animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/animation"
                            tools:ignore="DuplicateIds" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/doublePana"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="25dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:onClick="doublePana"
                            android:src="@drawable/dp" />

                        <ImageView
                            android:id="@+id/arrowIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:contentDescription="Arrow Icon"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="DuplicateIds" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- row third     -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/r3firstCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintEnd_toStartOf="@+id/r3secondCard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/starIcon"
                            android:layout_width="@dimen/_108sdp"
                            android:layout_height="@dimen/_108sdp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginVertical="@dimen/_14sdp"
                            android:contentDescription="Star Animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/animation"
                            tools:ignore="DuplicateIds" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/triplePana"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="25dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:onClick="triplePana"
                            android:src="@drawable/tp" />

                        <ImageView
                            android:id="@+id/arrowIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:contentDescription="Arrow Icon"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="DuplicateIds" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/r3secondCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="8dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/r3firstCard"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/starIcon"
                            android:layout_width="@dimen/_108sdp"
                            android:layout_height="@dimen/_108sdp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginVertical="@dimen/_14sdp"
                            android:contentDescription="Star Animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/animation"
                            tools:ignore="DuplicateIds" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/halfSangam"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginHorizontal="25dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:onClick="halfSangam"
                            android:src="@drawable/hs" />

                        <ImageView
                            android:id="@+id/arrowIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_gravity="end"
                            android:layout_margin="8dp"
                            android:contentDescription="Arrow Icon"
                            android:src="@drawable/ic_arrow"
                            tools:ignore="DuplicateIds" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
            >

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/starIcon"
                        android:layout_width="@dimen/_108sdp"
                        android:layout_height="@dimen/_108sdp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="@dimen/_18sdp"
                        android:layout_marginVertical="@dimen/_14sdp"
                        android:contentDescription="Star Animation"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/animation"
                        tools:ignore="DuplicateIds" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/fullSangam"
                        android:layout_width="120dp"
                        android:layout_height="125dp"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="25dp"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:onClick="fullSangam"
                        android:src="@drawable/fs" />

                    <ImageView
                        android:id="@+id/arrowIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_alignParentEnd="true"
                        android:layout_gravity="end"
                        android:layout_margin="8dp"
                        android:contentDescription="Arrow Icon"
                        android:src="@drawable/ic_arrow"
                        tools:ignore="DuplicateIds" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

</RelativeLayout>