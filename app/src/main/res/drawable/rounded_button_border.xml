<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient Background -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#3A4FAD"
                android:endColor="#000B3E" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Border -->
    <item >
        <shape>
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="#ffFFE3BB" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
